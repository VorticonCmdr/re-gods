# macOS
.DS_Store

# Dependencies — restore with `npm ci` (package-lock.json is tracked)
node_modules/

# Build output
dist/
.vite/

# The original game files. Commercial software — never commit them, never
# bundle them; dev serves them from here, a build asks for the user's copy.
game/

# Ghidra project (binary database, machine-local, not source): ghidra/gods.gpr + gods.rep/.
ghidra/

# Derived analysis artifacts — disassembly listings, unpacked PKLITE images,
# decompressed assets, workflow reports. Regenerable from game/ — see
# analysis/README.md for the verified recipes — or raw agent transcripts whose
# conclusions already live in CLAUDE.md and docs/. Track a specific file with
# `git add -f` if it ever becomes load-bearing.
analysis/

# Decompressed assets dumped by tools/blast.py into the working directory
/out_*

# Python bytecode
__pycache__/
*.pyc

# Claude Code session state; the project's skills ARE tracked
.claude/*
!.claude/skills/
.scratch_ignore/

# Raw memory dumps captured live from the running game (mask63_live.py) —
# bytes read straight out of the commercial binary, same reasoning as game/.
# object-mask-compare.mjs needs them to re-run; recapture with mask63_live.py.
tools/attract-capture/mask63/*.bin
